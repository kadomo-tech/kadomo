#!/usr/bin/env bash
# SketchyBar, ported from omarchy4mac and styled after Omarchy's bar: OmniWM-aware,
# one monospace font, and icons in the current Kadomo theme's foreground color.
# Reload: brew services restart sketchybar  (or: sketchybar --reload)

PLUGIN_DIR="$CONFIG_DIR/plugins"
source "$CONFIG_DIR/colors.sh"

# ---------- Bar ----------
# topmost=on: the macOS menu bar drops down when the pointer reaches the top of
# the screen. Below it (topmost=window), the bar loses every click to it.
sketchybar --bar \
  position=top \
  height=32 \
  blur_radius=30 \
  color="$BG" \
  border_width=0 \
  padding_left=12 \
  padding_right=12 \
  margin=0 \
  notch_width=200 \
  display=all \
  topmost=on

# ---------- Defaults ----------
default=(
  padding_left=2
  padding_right=2
  icon.font="JetBrainsMono Nerd Font:Regular:15.0"
  label.font="JetBrainsMono Nerd Font:Regular:13.0"
  icon.color="$FG"
  label.color="$FG"
  icon.padding_left=5
  icon.padding_right=5
  label.padding_left=4
  label.padding_right=4
  background.drawing=off
)
sketchybar --default "${default[@]}"

# ---------- Custom events ----------
sketchybar --add event omniwm_workspace_change

# ---------- Logo: opens Kadomo Menu (leftmost) ----------
sketchybar --add item logo left \
           --set logo \
                 icon="󰣇" \
                 label.drawing=off \
                 click_script="$HOME/.local/bin/kadomo-menu toggle"

# ---------- macOS menu bar: shows it and moves the bar down, or puts it back ----------
sketchybar --add item menu_bar left \
           --set menu_bar \
                 icon="󰍜" \
                 label.drawing=off \
                 click_script="$PLUGIN_DIR/menu_bar.sh toggle"

# ---------- OmniWM workspaces ----------
# Left out on a Mac without OmniWM (it needs macOS 26 on Apple silicon).
# A fixed width: the focused one's dot and the others' numbers differ.
OMNIWMCTL="$(command -v omniwmctl)"
if [ -n "$OMNIWMCTL" ]; then
  for sid in 1 2 3 4 5 6 7 8 9; do
    sketchybar --add item space."$sid" left \
               --subscribe space."$sid" omniwm_workspace_change \
               --set space."$sid" \
                     padding_left=0 \
                     padding_right=0 \
                     icon="$sid" \
                     icon.font="JetBrainsMono Nerd Font:Regular:13.0" \
                     icon.color="$COMMENT" \
                     icon.width=22 \
                     icon.align=center \
                     icon.padding_left=0 \
                     icon.padding_right=0 \
                     label.drawing=off \
                     click_script="$OMNIWMCTL command switch-workspace $sid" \
                     script="$PLUGIN_DIR/omniwm.sh"
  done
fi

# ---------- Front app (focused window) ----------
sketchybar --add item front_app left \
           --set front_app \
                 padding_left=12 \
                 icon.padding_right=4 \
                 script="$PLUGIN_DIR/front_app.sh" \
           --subscribe front_app front_app_switched

# Invisible, to catch clicks: the empty bar reports none. Between the front app and
# the notch, the last item on the left. Double click: plugins/bar_opacity.sh.
sketchybar --add item empty_left left \
           --set empty_left \
                 width=200 \
                 icon.drawing=off \
                 label.drawing=off \
                 click_script="$PLUGIN_DIR/bar_opacity.sh"

# ---------- Right, left to right ----------
# clock · weather · do not disturb · updates · stand-up · bluetooth · network
# · audio · power. Right items lay out right-to-left in add order, so battery
# goes first.
sketchybar --add item battery right \
           --set battery \
                 update_freq=120 \
                 script="$PLUGIN_DIR/battery.sh" \
                 click_script='open "x-apple.systempreferences:com.apple.Battery-Settings.extension"' \
           --subscribe battery system_woke power_source_change

sketchybar --add item volume right \
           --set volume \
                 update_freq=5 \
                 label.drawing=off \
                 script="$PLUGIN_DIR/volume.sh" \
                 click_script='open "x-apple.systempreferences:com.apple.Sound-Settings.extension"' \
           --subscribe volume volume_change

sketchybar --add item wifi right \
           --set wifi \
                 update_freq=30 \
                 label.drawing=off \
                 script="$PLUGIN_DIR/wifi.sh" \
                 click_script='open "x-apple.systempreferences:com.apple.wifi-settings-extension"' \
           --subscribe wifi wifi_change system_woke

sketchybar --add item bluetooth right \
           --set bluetooth \
                 update_freq=60 \
                 label.drawing=off \
                 script="$PLUGIN_DIR/bluetooth.sh" \
                 click_script='open "x-apple.systempreferences:com.apple.BluetoothSettings"'

# Stand-up / sit-down state of the interval timer (~/.hermes/standup_timer.sh).
# Icon only: a chair while seated, a standing person while standing. Hidden when
# no timer runs.
sketchybar --add item standup right \
           --set standup \
                 drawing=off \
                 update_freq=20 \
                 label.drawing=off \
                 script="$PLUGIN_DIR/standup.sh"

# Update badge: outdated Homebrew packages, hidden at zero (v4 bar).
# The click runs the upgrade, then fires brew_upgraded so the badge recounts at once.
sketchybar --add event brew_upgraded
sketchybar --add item updates right \
           --set updates \
                 drawing=off \
                 update_freq=21600 \
                 script="$PLUGIN_DIR/updates.sh" \
                 click_script="open -na Ghostty --args -e $PLUGIN_DIR/tui.sh sh -c 'brew update && brew upgrade; sketchybar --trigger brew_upgraded'" \
           --subscribe updates system_woke brew_upgraded

# Do Not Disturb shows only while it's on (v4 bar).
sketchybar --add item indicator_dnd right \
           --set indicator_dnd \
                 drawing=off \
                 label.drawing=off \
                 update_freq=10 \
                 script="$PLUGIN_DIR/indicators.sh"

sketchybar --add item weather right \
           --set weather \
                 drawing=off \
                 icon.drawing=off \
                 update_freq=1800 \
                 script="$PLUGIN_DIR/weather.sh" \
                 click_script='open https://wttr.in' \
           --subscribe weather system_woke

sketchybar --add item clock right \
           --set clock \
                 update_freq=10 \
                 icon.drawing=off \
                 padding_right=6 \
                 script="$PLUGIN_DIR/clock.sh" \
           --subscribe clock mouse.clicked

# Invisible, to catch clicks, like empty_left: between the notch and the right items.
sketchybar --add item empty_right right \
           --set empty_right \
                 width=320 \
                 icon.drawing=off \
                 label.drawing=off \
                 click_script="$PLUGIN_DIR/bar_opacity.sh"

# ---------- Force first run ----------
sketchybar --update

# Follow OmniWM: one watcher, replacing the one from before a reload. It reports
# the focused workspace as soon as it connects.
if [ -n "$OMNIWMCTL" ]; then
  pkill -f "$PLUGIN_DIR/omniwm_watch.sh" 2>/dev/null
  pkill -f "omniwmctl watch active-workspace" 2>/dev/null
  nohup "$PLUGIN_DIR/omniwm_watch.sh" >/dev/null 2>&1 &
fi

# A reload puts the bar back at the top, even with the menu bar showing.
"$PLUGIN_DIR/menu_bar.sh" sync

# Volume only subscribes to volume_change events, so prime it on startup
NAME=volume bash "$PLUGIN_DIR/volume.sh"

# Prime front_app on startup with the currently focused app name
FRONT_APP="$(osascript -e 'tell application "System Events" to get name of first application process whose frontmost is true' 2>/dev/null)"
NAME=front_app SENDER=front_app_switched INFO="$FRONT_APP" bash "$PLUGIN_DIR/front_app.sh"

# Prime the stand-up / sit-down icon on startup (it has no event to subscribe to)
NAME=standup bash "$PLUGIN_DIR/standup.sh"

# Run every item script once now: after a reload, an item is blank until its first
# update_freq tick (weather 30 min, updates 6 h).
sketchybar --update
